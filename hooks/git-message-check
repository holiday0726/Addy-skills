#!/usr/bin/env bash
# git 문구 검사 PreToolUse 훅 입구. 인자: <git_message_check> <python>
# 꺼져 있으면(기본) Python 을 띄우지 않고 바로 통과한다. Python 이 없는 PC 에서도 오류가 나지 않는다.
set -u
on="$(printf ' %s %s ' "${1:-}" "${CLAUDE_PLUGIN_OPTION_GIT_MESSAGE_CHECK:-}" | tr 'A-Z' 'a-z')"
case "$on" in
  *" true "*|*" 1 "*|*" yes "*|*" on "*) ;;
  *) exit 0 ;;
esac
py="${2:-}"
case "$py" in ''|'${user_config.python}') py=python3 ;; esac
exec "$py" "${0%/*}/git-message-style.py" true
